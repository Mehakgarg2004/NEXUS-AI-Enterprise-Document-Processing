# Copy to .env and fill in what you need. Everything has a sensible default.

# --- Database ---
# Local dev uses SQLite automatically. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://nexus:password@localhost:5432/nexus

# --- LLM (document Q&A + smart extraction) ---
# Provider: anthropic | openai | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Storage: local | s3 ---
STORAGE_BACKEND=local
# S3_BUCKET=my-nexus-documents
# AWS_REGION=ap-south-1
# (AWS credentials come from the usual AWS env vars / IAM role)

# --- MLflow ---
# MLFLOW_TRACKING_URI=http://localhost:5001

# --- OCR ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # Windows only
OCR_LANG=eng

# --- API security (optional) ---
# NEXUS_API_KEY=change-me
