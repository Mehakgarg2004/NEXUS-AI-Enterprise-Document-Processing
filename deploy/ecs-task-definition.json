{
  "family": "nexus-ai",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::ACCOUNT:role/nexusEcsExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT:role/nexusTaskRole",
  "containerDefinitions": [
    {
      "name": "nexus-ai",
      "image": "ACCOUNT.dkr.ecr.REGION.amazonaws.com/nexus-ai:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 5000, "protocol": "tcp" }],
      "environment": [
        { "name": "STORAGE_BACKEND", "value": "s3" },
        { "name": "S3_BUCKET", "value": "nexus-ai-documents-ACCOUNT" },
        { "name": "AWS_REGION", "value": "REGION" },
        { "name": "LLM_PROVIDER", "value": "anthropic" },
        { "name": "LLM_MODEL", "value": "claude-sonnet-5-5" },
        { "name": "MLFLOW_TRACKING_URI", "value": "http://mlflow.internal:5001" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:nexus/database-url" },
        { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:nexus/anthropic-api-key" },
        { "name": "NEXUS_API_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:nexus/api-key" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:5000/api/health')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nexus-ai",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
